# Optional historical suite runner. Supply a built application image.
ARG HAPPY_IMAGE=hap.py-py3
FROM ${HAPPY_IMAGE}
ENV HCDIR=/opt/happy/bin PYTHON=/opt/python/bin/python3.14
WORKDIR /opt/happy
# Set HGREF to a mounted, indexed hg19 FASTA; source fixtures must be writable.
CMD ["bash", "/opt/happy-source/src/sh/run_tests.sh"]
