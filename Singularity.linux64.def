Bootstrap: docker-daemon
From: ghcr.io/yuanfengzhang/hap.py:v0.3.16-alpha

%labels
    org.opencontainers.image.os linux
    org.opencontainers.image.architecture amd64
    org.happy.build.variant linux64
    org.opencontainers.image.title hap.py
    org.opencontainers.image.version v0.3.16-alpha

%environment
    # SIF root is read-only; preserve an explicit override, otherwise use the work directory.
    if [ -z "${TMPDIR:-}" ] || [ "$TMPDIR" = /opt/happy-tmp ]; then
        export TMPDIR="$PWD"
    fi
    export JAVA_HOME=/opt/jdk
    export PATH=/opt/happy/bin:/opt/happy-deps/bin:/opt/python/bin:$PATH

%runscript
    if [ "$(uname -s)" != Linux ] || [ "$(uname -m)" != x86_64 ]; then
        echo "Unsupported platform: Linux x86_64 required" >&2
        exit 1
    fi
    if [ "$#" -eq 0 ]; then
        exec /opt/happy/bin/hap.py --help
    fi
    exec /opt/happy/bin/hap.py "$@"

%test
    test "$(uname -s)" = Linux && test "$(uname -m)" = x86_64 || exit 1
    /opt/python/bin/python3.14 -I -c 'import ssl, numpy, pandas, pysam; print(ssl.OPENSSL_VERSION)'
    /opt/happy/bin/hap.py --version
    /opt/happy/libexec/rtg-tools-install/rtg version

%help
    Run: singularity run --cleanenv --env TMPDIR=/out/tmp -B INPUT:/data:ro -B OUTPUT:/out IMAGE.sif TRUTH QUERY -r REFERENCE -f BED -o /out/benchmark --scratch-prefix /out/tmp
    Use singularity exec to run other tools or select a custom command.
